<Project>
    <Target Name="AutoCollectAllRealDependencies" AfterTargets="ResolveAssemblyReferences" Condition="'$(GITHUB_ACTIONS)' != 'true'">
        <Message Importance="high" Text="[AutoCopy] Copying dependencies to $(LocalGitLibsPath)..." />
        <MakeDir Directories="$(LocalGitLibsPath)" Condition="!Exists('$(LocalGitLibsPath)')" />
        <ItemGroup>
            <AllRequiredDlls Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(CoreLibPath)'))" />
        </ItemGroup>
        <Copy SourceFiles="@(AllRequiredDlls)"
              DestinationFolder="$(LocalGitLibsPath)"
              SkipUnchangedFiles="true" />
        <Message Importance="high" Text="[AutoCopy] Done." />
    </Target>
    <Target Name="ValidateCIReadiness" DependsOnTargets="AutoCollectAllRealDependencies" Condition="'$(GITHUB_ACTIONS)' != 'true'">
        <ItemGroup>
            <CILibs Include="$(LocalGitLibsPath)\*.dll" />
        </ItemGroup>
        <Warning Text="[CI] CoreLibPath is not set. Create local.props based on local.props.example." Condition="'$(CoreLibPath)' == ''" />
        <Warning Text="[CI] '$(LocalGitLibsPath)' does not exist — run a local build first." Condition="!Exists('$(LocalGitLibsPath)')" />
        <Warning Text="[CI] '$(LocalGitLibsPath)' is empty — DLLs are not committed to git." Condition="Exists('$(LocalGitLibsPath)') AND '@(CILibs)' == ''" />
        <Warning Text="[CI] $(CoreProduct).Core.dll not found in $(LocalGitLibsPath)." Condition="!Exists('$(LocalGitLibsPath)\$(CoreProduct).Core.dll')" />
        <Warning Text="[CI] Autogenerated\Lib\ not found — Reference Items will be empty." Condition="!Exists('$(RelativeCurrentPkgFolderPath)Autogenerated\Lib\')" />
        <Message Importance="High" Text="[CI] ValidateCIReadiness done." />
    </Target>
</Project>
