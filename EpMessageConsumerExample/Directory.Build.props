<Project>
    <!-- Analyzers are set in .targets: AssemblyName is empty here in a package build.
         The guard is for Dev csproj that import this file after AssemblyName. -->
    <PropertyGroup Condition="!$(AssemblyName.EndsWith('.Configuration'))">
        <EnableReferenceTrimmer Condition=" '$(EnableReferenceTrimmer)' == '' ">false</EnableReferenceTrimmer>
    </PropertyGroup>
</Project>
