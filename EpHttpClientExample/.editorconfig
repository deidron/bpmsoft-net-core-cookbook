# Package overrides (no root = true): netstandard2.0 and BPMSoft conventions only.

[*.cs]
# Using directives inside the namespace — BPMSoft schema convention.
csharp_using_directive_placement = inside_namespace

# netstandard2.0 ships no System.Index / System.Range, so ^i and a..b do not compile.
csharp_style_prefer_index_operator = false
csharp_style_prefer_range_operator = false

# IDE0130: Namespace does not match folder structure — BPMSoft/Creatio package
# folders (Pkg/<PackageName>/...) are not tied to C# namespaces by platform convention.
dotnet_style_namespace_match_folder = false

# CA1822: WCF/BPMSoft service methods must be instance methods — static is not valid here.
[*Service.cs]
dotnet_diagnostic.CA1822.severity = none
