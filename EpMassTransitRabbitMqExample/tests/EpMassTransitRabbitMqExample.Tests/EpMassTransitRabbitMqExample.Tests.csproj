<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)$(MSBuildProjectName).props" Condition="Exists('$(MSBuildThisFileDirectory)$(MSBuildProjectName).props')" />
  <PropertyGroup Label="Path">
    <RelativeCurrentPkgFolderPath Condition="'$(RelativeCurrentPkgFolderPath)' == ''">../../</RelativeCurrentPkgFolderPath>
    <RelativePkgFolderPath Condition="'$(RelativePkgFolderPath)' == ''">$(RelativeCurrentPkgFolderPath)..</RelativePkgFolderPath>
  </PropertyGroup>
  <PropertyGroup Label="Local test settings">
    <RunSettingsFilePath Condition="Exists('$(MSBuildThisFileDirectory)local.runsettings')">$(MSBuildThisFileDirectory)local.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\EpMassTransitRabbitMqExample.csproj" />
  </ItemGroup>
  <ItemGroup Label="Platform References">
    <Reference Include="Autofac">
      <HintPath>$(CoreLibPath)/Autofac.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Common.Logging">
      <HintPath>$(CoreLibPath)/Common.Logging.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Common.Logging.Core">
      <HintPath>$(CoreLibPath)/Common.Logging.Core.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="GreenPipes">
      <HintPath>$(CoreLibPath)/GreenPipes.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="MassTransit">
      <HintPath>$(CoreLibPath)/MassTransit.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
  <ItemGroup Label="Integration References">
    <Reference Include="Autofac.Extensions.DependencyInjection">
      <HintPath>$(CoreLibPath)/Autofac.Extensions.DependencyInjection.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Automatonymous">
      <HintPath>$(CoreLibPath)/Automatonymous.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="$(CoreProduct).Core">
      <HintPath>$(CoreLibPath)/$(CoreProduct).Core.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="System.Configuration.ConfigurationManager">
      <HintPath>$(CoreLibPath)/System.Configuration.ConfigurationManager.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="MassTransit.ExtensionsDependencyInjectionIntegration">
      <HintPath>$(CoreLibPath)/MassTransit.ExtensionsDependencyInjectionIntegration.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>$(CoreLibPath)/Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="MassTransit.RabbitMqTransport">
      <HintPath>$(CoreLibPath)/MassTransit.RabbitMqTransport.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="NewId">
      <HintPath>$(CoreLibPath)/NewId.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(CoreLibPath)/Newtonsoft.Json.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Newtonsoft.Json.Bson">
      <HintPath>$(CoreLibPath)/Newtonsoft.Json.Bson.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RabbitMQ.Client">
      <HintPath>$(CoreLibPath)/RabbitMQ.Client.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)$(MSBuildProjectName).targets" Condition="Exists('$(MSBuildThisFileDirectory)$(MSBuildProjectName).targets')" />
</Project>
